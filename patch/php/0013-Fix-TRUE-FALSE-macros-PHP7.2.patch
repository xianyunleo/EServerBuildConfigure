From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: EServer Build <build@eserver.local>
Date: Thu, 19 Nov 2026 22:05:00 +0800
Subject: [PATCH] Fix undeclared TRUE/FALSE in ext/intl (ICU 68+ dropped them)

ICU's public headers no longer provide the TRUE/FALSE macros, so PHP 7.2's
ext/intl fails to compile against ICU 75+:

  ext/intl/collator/collator_sort.c:349:26: error: use of undeclared identifier 'TRUE'
  ext/intl/collator/collator_sort.c:543:26: error: use of undeclared identifier 'FALSE'

PHP 7.3+ already use 1/0 here; backport the same replacements to 7.2.
---
diff --git a/ext/intl/collator/collator_sort.c b/ext/intl/collator/collator_sort.c
--- a/ext/intl/collator/collator_sort.c
+++ b/ext/intl/collator/collator_sort.c
@@ -346,7 +346,7 @@
  */
 PHP_FUNCTION( collator_sort )
 {
-	collator_sort_internal( TRUE, INTERNAL_FUNCTION_PARAM_PASSTHRU );
+	collator_sort_internal( 1, INTERNAL_FUNCTION_PARAM_PASSTHRU );
 }
 /* }}} */
 
@@ -540,7 +540,7 @@
  */
 PHP_FUNCTION( collator_asort )
 {
-	collator_sort_internal( FALSE, INTERNAL_FUNCTION_PARAM_PASSTHRU );
+	collator_sort_internal( 0, INTERNAL_FUNCTION_PARAM_PASSTHRU );
 }
 /* }}} */
 
diff --git a/ext/intl/dateformat/dateformat_attr.c b/ext/intl/dateformat/dateformat_attr.c
--- a/ext/intl/dateformat/dateformat_attr.c
+++ b/ext/intl/dateformat/dateformat_attr.c
@@ -88,7 +88,7 @@
 	UChar  value_buf[64];
 	uint32_t    length = USIZE( value_buf );
 	UChar* value  = value_buf;
-	zend_bool   is_pattern_localized =FALSE;
+	zend_bool   is_pattern_localized = 0;
 
 	DATE_FORMAT_METHOD_INIT_VARS;
 
@@ -131,7 +131,7 @@
 	size_t      value_len = 0;
 	int32_t     slength = 0;
 	UChar*	    svalue  = NULL;
-	zend_bool   is_pattern_localized =FALSE;
+	zend_bool   is_pattern_localized = 0;
 
 
 	DATE_FORMAT_METHOD_INIT_VARS;
@@ -227,7 +227,7 @@
  */
 PHP_FUNCTION( datefmt_set_lenient )
 {
-	zend_bool isLenient  = FALSE;
+	zend_bool isLenient  = 0;
 
 	DATE_FORMAT_METHOD_INIT_VARS;
 
diff --git a/ext/intl/normalizer/normalizer_normalize.c b/ext/intl/normalizer/normalizer_normalize.c
--- a/ext/intl/normalizer/normalizer_normalize.c
+++ b/ext/intl/normalizer/normalizer_normalize.c
@@ -178,7 +178,7 @@
 	int		uinput_len = 0;
 	UErrorCode	status = U_ZERO_ERROR;
 
-	UBool		uret = FALSE;
+	UBool		uret = 0;
 
 	intl_error_reset( NULL );
 
