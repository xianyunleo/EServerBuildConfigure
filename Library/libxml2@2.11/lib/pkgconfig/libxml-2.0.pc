prefix=/Applications/EServer/Library/libxml2@2.11
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include
modules=1

Name: libXML
Version: 2.11.9
Description: libXML library version2.
Requires:
Libs: -L${libdir} -lxml2
Libs.private: -L/Applications/EServer/Library/zlib/lib -lz   -liconv    
Cflags: -I${includedir}/libxml2 
